spell = liza.cantrips["Eldritch Blast"]

range(spell.attacks) |> foreach((attack)) => {
    print(attack.roll)
}

for attack in spell.attacks {
    print(attack.roll)
}

liza.spells |> foreach((spell) => {
    if spell.attack != None:
        print(roll spell.attack)
})


